  "routes": {
    "gpt-image-2.6": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6--aivalux-gpt",
      "candidates": [
        "gpt-image-2.6--aivalux-gpt",
        "gpt-image-2.6--gateai-gpt"
      ]
    },
    "gpt-image-2.6-flare": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6-flare--aivalux-gpt",
      "candidates": [
        "gpt-image-2.6-flare--aivalux-gpt",
        "gpt-image-2.6-flare--gateai-gpt"
      ]
    },
    "gpt-image-2.6-sunburst": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6-sunburst--aivalux-gpt",
      "candidates": [
        "gpt-image-2.6-sunburst--aivalux-gpt",
        "gpt-image-2.6-sunburst--gateai-gpt"
      ]
    },
    "gpt-image-2.5": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.5--aivalux-gpt",
      "candidates": [
        "gpt-image-2.5--aivalux-gpt",
        "gpt-image-2.5--gateai-gpt"
      ]
    },
    "grok-imagine-image-2.0": {
      "policy": "fixed",
      "preferred_binding": "grok-imagine-image-2.0--aivalux-grok",
      "candidates": [
        "grok-imagine-image-2.0--aivalux-grok"
      ]
    },
    "grok-imagine-video-1.5": {
      "policy": "automatic-same-model",
      "preferred_binding": "grok-imagine-video-1.5--aivalux-grok",
      "candidates": [
        "grok-imagine-video-1.5--aivalux-grok",
        "grok-imagine-video-1.5--rapidapi-grok",
        "grok-imagine-video-1.5--rapidapi-grok--legacy-newapi-json"
      ]
    },
    "muse-video": {
      "policy": "automatic-same-model",
      "preferred_binding": "muse-video--aivalux-grok",
      "candidates": [
        "muse-video--aivalux-grok",
        "muse-video--rapidapi-grok"
      ]
    },
