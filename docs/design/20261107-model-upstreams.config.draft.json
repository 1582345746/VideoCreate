{
  "schema_version": 3,
  "product": "VideoCreate",
  "defaults": {
    "video_model": "grok-imagine-video-1.5",
    "image_model": "gpt-image-2.6",
    "resolution": "720p",
    "aspect_ratio": "9:16"
  },
  "models": {
    "gpt-image-2.6": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "gpt-image-2.6"
    },
    "gpt-image-2.6-flare": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "gpt-image-2.6-flare"
    },
    "gpt-image-2.6-sunburst": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "gpt-image-2.6-sunburst"
    },
    "gpt-image-2.5": {
      "kind": "image",
