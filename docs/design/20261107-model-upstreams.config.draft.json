  "execution": {
    "max_concurrent_image_tasks": 2,
    "max_concurrent_video_tasks": 2,
    "allow_cross_model_fallback": false,
    "unknown_submission": "hold-and-reconcile",
    "read_retry_attempts": 3,
    "max_create_attempts_per_task": 3,
    "require_binding_snapshot": true,
    "paid_probe_on_install": false
  },
  "budget": {
    "currency": "CNY",
    "max_total": null,
    "max_image_requests": 12,
    "max_video_requests": 12,
    "default_candidates_per_task": 1,
    "unknown_price_policy": "report-unknown-and-apply-request-limit"
  }
