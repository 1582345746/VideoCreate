    "grok-imagine-image-2.0": {
      "kind": "image",
      "family": "grok",
      "display_name": "Grok Image 2.0"
    },
    "grok-imagine-video-1.5": {
      "kind": "video",
      "family": "grok",
      "display_name": "Grok Video 1.5"
    },
    "muse-video": {
      "kind": "video",
      "family": "muse",
      "display_name": "Muse Video (identity to verify)"
    },
    "seedance-2.0-mini-720p": {
      "kind": "video",
      "family": "seedance",
      "display_name": "Existing Seedance ID (remote contract unverified)"
    }
  },
  "upstreams": {
    "aivalux-gpt": {
      "display_name": "aivalux-gpt",
      "platform": "sub2api",
      "base_url": "https://www.aivalux.com",
      "auth": {
        "type": "bearer",
        "env": "VIDEOCREATE_AIVALUX_GPT_API_KEY"
      },
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "gateai-gpt": {
      "display_name": "gateai-gpt",
      "platform": "sub2api",
      "base_url": "https://gateai.cc",
      "auth": {
        "type": "bearer",
        "env": "VIDEOCREATE_GATEAI_GPT_API_KEY"
      },
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "aivalux-grok": {
      "display_name": "aivalux-grok",
      "platform": "sub2api",
      "base_url": "https://www.aivalux.com",
      "auth": {
        "type": "bearer",
        "env": "VIDEOCREATE_AIVALUX_GROK_API_KEY"
      },
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "rapidapi-grok": {
      "display_name": "rapidapi-grok",
      "platform": "sub2api",
      "base_url": "https://rapidapi.cc",
      "auth": {
        "type": "bearer",
        "env": "VIDEOCREATE_RAPIDAPI_GROK_API_KEY"
      },
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    }
  },
  "bindings": {
    "gpt-image-2.6--aivalux-gpt": {
      "enabled": false,
