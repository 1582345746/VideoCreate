{
  "schema_version": 3,
  "product": "VideoCreate",
  "defaults": {
    "video_model": "grok-imagine-video-1.5",
    "image_model": "gpt-image-2.6",
    "aspect_ratio": "9:16",
    "resolution": "720p",
    "audio_mode": "native-dialogue",
    "subtitle_source": "none",
    "pace_profile": "story-adaptive",
    "workflow": "api-image-api-video"
  },
  "models": {
    "grok-imagine-video-1.5": {
      "kind": "video",
      "family": "grok",
      "display_name": "Grok Imagine Video 1.5",
      "prompt_profile": "grok-current-shot-v1"
    },
    "seedance-2.0-mini-720p": {
      "kind": "video",
      "family": "seedance",
      "display_name": "Seedance configured channel model",
      "prompt_profile": "seedance-current-shot-v1"
    },
    "gpt-image-2.5": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "GPT Image 2.5"
    },
    "gpt-image-2.6": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "GPT Image 2.6"
    },
    "gpt-image-2.6-flare": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "GPT Image 2.6 Flare"
    },
    "gpt-image-2.6-sunburst": {
      "kind": "image",
      "family": "gpt-image",
      "display_name": "GPT Image 2.6 Sunburst"
    },
    "grok-imagine-image-2.0": {
      "kind": "image",
      "family": "grok",
      "display_name": "Grok Imagine Image 2.0"
    },
    "muse-video": {
      "kind": "video",
      "family": "muse",
      "display_name": "Muse Video"
    }
  },
  "upstreams": {
    "primary-sub2api": {
      "display_name": "My Sub2API",
      "platform": "sub2api",
      "base_url": "https://your-sub2api-host.example",
      "auth": {
        "type": "bearer",
        "api_key": ""
      },
      "max_concurrent_submissions": 50,
      "request_timeout_seconds": 120
    },
    "backup-newapi": {
      "display_name": "My NewAPI",
      "platform": "newapi",
      "base_url": "https://your-newapi-host.example",
      "auth": {
        "type": "bearer",
        "api_key": ""
      },
      "max_concurrent_submissions": 50,
      "request_timeout_seconds": 120
    },
    "image-service": {
      "display_name": "My image service",
      "platform": "sub2api",
      "base_url": "https://your-image-host.example",
      "auth": {
        "type": "bearer",
        "api_key": ""
      },
      "max_concurrent_submissions": 50,
      "request_timeout_seconds": 120
    },
    "aivalux-gpt": {
      "display_name": "Aivalux GPT image",
      "platform": "sub2api",
      "base_url": "https://www.aivalux.com",
      "auth": {"type": "bearer", "env": "VIDEOCREATE_AIVALUX_GPT_API_KEY"},
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "gateai-gpt": {
      "display_name": "GateAI GPT image",
      "platform": "sub2api",
      "base_url": "https://gateai.cc",
      "auth": {"type": "bearer", "env": "VIDEOCREATE_GATEAI_GPT_API_KEY"},
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "aivalux-grok": {
      "display_name": "Aivalux Grok",
      "platform": "sub2api",
      "base_url": "https://www.aivalux.com",
      "auth": {"type": "bearer", "env": "VIDEOCREATE_AIVALUX_GROK_API_KEY"},
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    },
    "rapidapi-grok": {
      "display_name": "RapidAPI Grok",
      "platform": "sub2api",
      "base_url": "https://rapidapi.cc",
      "auth": {"type": "bearer", "env": "VIDEOCREATE_RAPIDAPI_GROK_API_KEY"},
      "max_concurrent_submissions": 2,
      "request_timeout_seconds": 120
    }
  },
  "bindings": {
    "grok-on-sub2api": {
      "enabled": false,
      "setup_status": "needs-configuration-and-contract-check",
      "model": "grok-imagine-video-1.5",
      "upstream": "primary-sub2api",
      "remote_model": "grok-imagine-video-1.5",
      "adapter": "sub2api-json-v1",
      "operations": [
        "text-to-video",
        "image-to-video"
      ],
      "capability_profile": "grok-sub2api-pending-verification",
      "capability_overrides": {},
      "adapter_options": {}
    },
    "grok-on-newapi": {
      "enabled": false,
      "setup_status": "needs-configuration-and-contract-check",
      "model": "grok-imagine-video-1.5",
      "upstream": "backup-newapi",
      "remote_model": "grok-imagine-video-1.5",
      "adapter": "newapi-multipart-v1",
      "operations": [
        "text-to-video",
        "image-to-video"
      ],
      "capability_profile": "grok-newapi-pending-verification",
      "capability_overrides": {},
      "adapter_options": {}
    },
    "seedance-on-sub2api": {
      "enabled": false,
      "setup_status": "needs-configuration-and-contract-check",
      "model": "seedance-2.0-mini-720p",
      "upstream": "primary-sub2api",
      "remote_model": "REPLACE_WITH_EXACT_REMOTE_SEEDANCE_MODEL_ID",
      "adapter": "sub2api-json-v1",
      "operations": [
        "text-to-video",
        "image-to-video"
      ],
      "capability_profile": "seedance-sub2api-pending-verification",
      "capability_overrides": {},
      "adapter_options": {}
    },
    "seedance-on-newapi": {
      "enabled": false,
      "setup_status": "needs-configuration-and-contract-check",
      "model": "seedance-2.0-mini-720p",
      "upstream": "backup-newapi",
      "remote_model": "REPLACE_WITH_EXACT_REMOTE_SEEDANCE_MODEL_ID",
      "adapter": "newapi-json-v1",
      "operations": [
        "text-to-video",
        "image-to-video"
      ],
      "capability_profile": "seedance-newapi-pending-verification",
      "capability_overrides": {},
      "adapter_options": {}
    },
    "image-primary": {
      "enabled": false,
      "setup_status": "needs-configuration-and-contract-check",
      "model": "gpt-image-2.5",
      "upstream": "image-service",
      "remote_model": "gpt-image-2.5",
      "adapter": "openai-images-v1",
      "operations": [
        "text-to-image",
        "image-edit"
      ],
      "capability_profile": "image-service-pending-verification",
      "capability_overrides": {},
      "adapter_options": {}
    },
    "gpt-image-2.6--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "gpt-image-2.6", "upstream": "aivalux-gpt", "remote_model": "gpt-image-2.6",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.6--gateai": {
      "enabled": false, "setup_status": "user-declared-contract-unverified",
      "model": "gpt-image-2.6", "upstream": "gateai-gpt", "remote_model": "gpt-image-2.6",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.6-flare--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "gpt-image-2.6-flare", "upstream": "aivalux-gpt", "remote_model": "gpt-image-2.6-flare",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.6-flare--gateai": {
      "enabled": false, "setup_status": "user-declared-contract-unverified",
      "model": "gpt-image-2.6-flare", "upstream": "gateai-gpt", "remote_model": "gpt-image-2.6-flare",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.6-sunburst--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "gpt-image-2.6-sunburst", "upstream": "aivalux-gpt", "remote_model": "gpt-image-2.6-sunburst",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.6-sunburst--gateai": {
      "enabled": false, "setup_status": "user-declared-contract-unverified",
      "model": "gpt-image-2.6-sunburst", "upstream": "gateai-gpt", "remote_model": "gpt-image-2.6-sunburst",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.5--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "gpt-image-2.5", "upstream": "aivalux-gpt", "remote_model": "gpt-image-2.5",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "gpt-image-2.5--gateai": {
      "enabled": false, "setup_status": "user-declared-contract-unverified",
      "model": "gpt-image-2.5", "upstream": "gateai-gpt", "remote_model": "gpt-image-2.5",
      "adapter": "openai-images-v1", "operations": ["text-to-image", "image-edit"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "grok-imagine-image-2.0--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-image-contract-unverified",
      "model": "grok-imagine-image-2.0", "upstream": "aivalux-grok", "remote_model": "grok-imagine-image-2.0",
      "adapter": "openai-images-v1", "operations": ["text-to-image"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "grok-video--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "grok-imagine-video-1.5", "upstream": "aivalux-grok", "remote_model": "grok-imagine-video-1.5",
      "adapter": "sub2api-json-v1", "operations": ["text-to-video", "image-to-video"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "grok-video--rapidapi": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "grok-imagine-video-1.5", "upstream": "rapidapi-grok", "remote_model": "grok-imagine-video-1.5",
      "adapter": "sub2api-json-v1", "operations": ["text-to-video", "image-to-video"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "muse-video--aivalux": {
      "enabled": false, "setup_status": "catalog-seen-contract-unverified",
      "model": "muse-video", "upstream": "aivalux-grok", "remote_model": "muse-video",
      "adapter": "sub2api-json-v1", "operations": ["text-to-video", "image-to-video"],
      "capability_overrides": {}, "adapter_options": {}
    },
    "muse-video--rapidapi": {
      "enabled": false, "setup_status": "catalog-not-seen-contract-unverified",
      "model": "muse-video", "upstream": "rapidapi-grok", "remote_model": "muse-video",
      "adapter": "sub2api-json-v1", "operations": ["text-to-video", "image-to-video"],
      "capability_overrides": {}, "adapter_options": {}
    }
  },
  "routes": {
    "grok-imagine-video-1.5": {
      "policy": "automatic-same-model",
      "preferred_binding": "grok-video--aivalux",
      "candidates": [
        "grok-video--aivalux",
        "grok-video--rapidapi",
        "grok-on-sub2api",
        "grok-on-newapi"
      ]
    },
    "seedance-2.0-mini-720p": {
      "policy": "automatic-same-model",
      "preferred_binding": "seedance-on-sub2api",
      "candidates": [
        "seedance-on-sub2api",
        "seedance-on-newapi"
      ]
    },
    "gpt-image-2.5": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.5--aivalux",
      "candidates": [
        "gpt-image-2.5--aivalux",
        "gpt-image-2.5--gateai",
        "image-primary"
      ]
    },
    "gpt-image-2.6": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6--aivalux",
      "candidates": ["gpt-image-2.6--aivalux", "gpt-image-2.6--gateai"]
    },
    "gpt-image-2.6-flare": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6-flare--aivalux",
      "candidates": ["gpt-image-2.6-flare--aivalux", "gpt-image-2.6-flare--gateai"]
    },
    "gpt-image-2.6-sunburst": {
      "policy": "automatic-same-model",
      "preferred_binding": "gpt-image-2.6-sunburst--aivalux",
      "candidates": ["gpt-image-2.6-sunburst--aivalux", "gpt-image-2.6-sunburst--gateai"]
    },
    "grok-imagine-image-2.0": {
      "policy": "fixed",
      "preferred_binding": "grok-imagine-image-2.0--aivalux",
      "candidates": ["grok-imagine-image-2.0--aivalux"]
    },
    "muse-video": {
      "policy": "automatic-same-model",
      "preferred_binding": "muse-video--aivalux",
      "candidates": ["muse-video--aivalux", "muse-video--rapidapi"]
    }
  },
  "model_selection": {
    "image": {
      "policy": "first-compatible",
      "candidates": ["gpt-image-2.6", "gpt-image-2.6-flare", "gpt-image-2.6-sunburst", "gpt-image-2.5", "grok-imagine-image-2.0"]
    }
  },
  "execution": {
    "max_concurrent_image_tasks": 6,
    "max_concurrent_video_tasks": 6,
    "allow_cross_model_fallback": false,
    "unknown_submission": "hold-and-reconcile",
    "read_retry_attempts": 3,
    "max_create_attempts_per_task": 3,
    "require_binding_snapshot": true,
    "paid_probe_on_install": false
  },
  "budget": {
    "currency": "CNY",
    "max_total": null,
    "max_image_requests": 12,
    "max_video_requests": 12,
    "default_candidates_per_task": 1,
    "unknown_price_policy": "report-unknown-and-apply-request-limit"
  },
  "review": {
    "structural_is_content_approval": false,
    "require_narrative_understanding_for_story": true,
    "require_temporal_review_for_motion": true,
    "require_audio_review_for_speech": true,
    "unverified_output_label": "draft_preview"
  },
  "browser_services": {
    "museai": {
      "enabled": false,
      "display_name": "Muse browser (generation unverified)",
      "driver": "codex-browser",
      "base_url": "https://muse.ai/",
      "allowed_origins": [
        "https://muse.ai"
      ],
      "requested_operations": [
        "text-to-image",
        "image-edit",
        "text-to-video",
        "image-to-video"
      ]
    }
  },
  "workflows": {
    "api-image-api-video": {
      "description": "API image then API image-to-video",
      "stages": [
        {
          "id": "image",
          "executor": "api",
          "operation": "text-to-image"
        },
        {
          "id": "video",
          "executor": "api",
          "operation": "image-to-video",
          "input_from": "image"
        }
      ]
    },
    "muse-image": {
      "description": "Muse text-to-image (requires live verification)",
      "stages": [
        {
          "id": "image",
          "executor": "browser",
          "operation": "text-to-image",
          "service": "museai"
        }
      ]
    },
    "muse-video": {
      "description": "Muse text-to-video (requires live verification)",
      "stages": [
        {
          "id": "video",
          "executor": "browser",
          "operation": "text-to-video",
          "service": "museai"
        }
      ]
    },
    "muse-image-video": {
      "description": "Muse image then Muse image-to-video (requires live verification)",
      "stages": [
        {
          "id": "image",
          "executor": "browser",
          "operation": "text-to-image",
          "service": "museai"
        },
        {
          "id": "video",
          "executor": "browser",
          "operation": "image-to-video",
          "service": "museai",
          "input_from": "image"
        }
      ]
    },
    "api-image-muse-video": {
      "description": "API image then Muse image-to-video (requires live verification)",
      "stages": [
        {
          "id": "image",
          "executor": "api",
          "operation": "text-to-image"
        },
        {
          "id": "video",
          "executor": "browser",
          "operation": "image-to-video",
          "service": "museai",
          "input_from": "image"
        }
      ]
    }
  }
}
